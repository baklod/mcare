# Copy to .env.docker. The setup script does this only when the file is absent.
# Never put production credentials in this file.

APP_NAME=MCARE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Local role testing only. Keep two-factor authentication enabled in production.
TWO_FACTOR_ENABLED=false
TWO_FACTOR_ROLES=admin

# Host-bound development ports. XAMPP continues using MariaDB port 3306.
DOCKER_APP_PORT=8000
DOCKER_VITE_PORT=5173
DOCKER_DB_HOST_PORT=3307

# This database exists only in the Docker named volume.
DOCKER_DB_DATABASE=mcare_docker_dev
DOCKER_DB_USERNAME=mcare
DOCKER_DB_PASSWORD=SETUP_GENERATES_A_RANDOM_LOCAL_PASSWORD

# Optional integrations: leave empty unless a developer supplies local test values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVE_MODE=false
PAYMONGO_PAYMENT_METHODS=gcash,card,qrph
PAYMONGO_WEBHOOK_TOLERANCE=300

VITE_APP_NAME=MCARE
